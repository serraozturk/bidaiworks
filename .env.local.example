# =====================================================
# bidAI environment variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to git.
# =====================================================

# --- Supabase ---------------------------------------------------
# From your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only (NEVER expose to the client). Used for admin operations
# such as creating storage buckets in setup scripts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Admin panel ------------------------------------------------
# Comma-separated list of emails allowed into the /admin control panel.
ADMIN_EMAILS=you@example.com

# --- Email notifications ---------------------------------------
# Resend API key. When this is empty, emails are logged as dry-runs only.
RESEND_API_KEY=re_your-key-here

# Verified sender address in Resend.
EMAIL_FROM=bidAI <notifications@yourdomain.com>

# --- Anthropic Claude (AI cost estimate) ------------------------
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model used for cost estimates. Haiku is fast + cheap; bump to Sonnet
# for higher-quality estimates once you have real project examples.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- App ---------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://bidaiworks-web.hmldpk.easypanel.host
